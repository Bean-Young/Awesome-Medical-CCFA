--- /dev/null
+++ b/scripts/verify_paged_data.py
@@ -0,0 +1,44 @@
+"""Verify every emitted versioned page, full bytes, snapshot fields and bounded transport."""
+from pathlib import Path
+import base64,gzip,hashlib,json,re
+from catalogue_source import parse_json,same_json
+from compact_static_json import compact
+
+def verify_paged(root,runtime):
+ root=Path(root);runtime=Path(runtime);directory=runtime/'data/papers-v1'
+ mb=(directory/'manifest.json').read_bytes();assert len(mb)<=65536
+ sha=lambda b:hashlib.sha256(b).hexdigest();mh=sha(mb);m=parse_json(mb)
+ assert (directory/f'manifest.{mh}.json').read_bytes()==mb
+ bootstrap=(runtime/'data/bootstrap.js').read_text();assert f'"manifest_sha256":"{mh}"' in bootstrap and f'"manifest_bytes":{len(mb)}' in bootstrap
+ assert m['schema_version']==1 and m['protocol']=='medical-ccfa-papers-v1'
+ assert 1<=len(m['pages'])<=16 and 1<=m['paper_count']<=5000
+ prefix=base64.b64decode(m['raw']['prefix_b64'],validate=True);suffix=base64.b64decode(m['raw']['suffix_b64'],validate=True)
+ assert re.fullmatch(rb'[ \t\r\n]*\[',prefix) and re.fullmatch(rb'\][ \t\r\n]*',suffix)
+ parts=[];papers=[];ids=[];offset=0;total=0;expected={f'manifest.{mh}.json','manifest.json',f'download.{mh}.html','download.html',f'download.{mh}.js'}
+ for i,p in enumerate(m['pages']):
+  assert p['index']==i and p['start']==offset and type(p['count']) is int and p['count']>0
+  assert type(p['bytes'])is int and 2<=p['bytes']<=4*1024*1024
+  assert re.fullmatch('[0-9a-f]{64}',p['sha256']);assert p['url']==f"data/papers-v1/pages/{p['sha256']}.json"
+  b=(runtime/p['url']).read_bytes();assert len(b)==p['bytes'] and sha(b)==p['sha256'] and b[:1]==b'[' and b[-1:]==b']'
+  assert len(gzip.compress(b,compresslevel=9,mtime=0))<=2*1024*1024
+  data=parse_json(b.decode('utf-8'));assert isinstance(data,list) and len(data)==p['count'];papers.extend(data);ids.extend(x['id']for x in data)
+  parts.append(b[1:-1]);offset+=len(data);total+=len(b);expected.add(f"pages/{p['sha256']}.json")
+ assert offset==m['paper_count'] and len(set(ids))==len(ids) and all(type(x)is str and x for x in ids)
+ assert sha(json.dumps(ids,ensure_ascii=False,separators=(',',':')).encode())==m['ordered_ids_sha256']
+ raw=prefix+b','.join(parts)+suffix;assert len(raw)==m['raw']['bytes'] and sha(raw)==m['raw']['sha256']
+ source_raw=(compact((root/'data/papers.json').read_text())+'\n').encode();assert raw==source_raw,'Exact public JSON bytes changed'
+ snapshot=parse_json((root/'data/snapshot.json').read_bytes());assert same_json(papers,snapshot['papers'])
+ assert m['keys']==list(snapshot) and same_json(m['scalars'],{k:v for k,v in snapshot.items()if k not in ('papers','coverage','scope')})
+ for i,key in enumerate(('coverage','scope')):
+  f=m['sidecars'][i];assert f['key']==key and f['url']==f'data/{key}.json' and 1<=f['bytes']<=2*1024*1024
+  b=(runtime/f['url']).read_bytes();assert len(b)==f['bytes'] and sha(b)==f['sha256'];assert same_json(parse_json(b),snapshot[key]);total+=len(b)
+ assert total==m['aggregate_bytes'] and total<=48*1024*1024
+ assert m['legacy']=={'url':'data/papers.json','available':len(raw)<=32*1024*1024 and len(gzip.compress(raw,compresslevel=9,mtime=0))<=8*1024*1024,'raw_limit_bytes':32*1024*1024,'gzip_limit_bytes':8*1024*1024}
+ actual={str(p.relative_to(directory))for p in directory.rglob('*')if p.is_file()};assert actual==expected,{'extra':actual-expected,'missing':expected-actual}
+ for p in directory.rglob('*'):
+  if p.is_file():assert not re.search(rb'/workspace/(?:shared|scratch)|/home/agent',p.read_bytes()),p
+ return {'records':len(papers),'pages':len(parts),'raw_bytes':len(raw),'aggregate_bytes':total,'legacy_available':m['legacy']['available'],'manifest_sha256':mh}
+
+if __name__=='__main__':
+ import sys
+ root=Path(__file__).resolve().parents[1];runtime=root/(sys.argv[1]if len(sys.argv)>1 else'dist');print(json.dumps(verify_paged(root,runtime),sort_keys=True))
