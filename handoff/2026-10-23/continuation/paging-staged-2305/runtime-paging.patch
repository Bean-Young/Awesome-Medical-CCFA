+import { createCatalogueHandler } from './catalogue-handler.mjs';
+// Existing legacy handler and its 32 MiB raw / 8 MiB gzip checks are unchanged.
+export function createCatalogueRouter(manifest) {
+  if (manifest.available !== false) return createCatalogueHandler(manifest);
+  if (!Number.isSafeInteger(manifest.rawBytes) || !Number.isSafeInteger(manifest.gzipBytes) || manifest.rawBytes < 1 || manifest.gzipBytes < 1 || (manifest.rawBytes <= 32 * 1024 * 1024 && manifest.gzipBytes <= 8 * 1024 * 1024) || manifest.manifestPath !== '/data/papers-v1/manifest.json' || manifest.downloadPath !== '/data/papers-v1/download.html') throw Error('Invalid unavailable legacy representation');
+  const body = JSON.stringify({error:'catalogue_requires_paging',message:'The complete catalogue exceeds this endpoint\'s unchanged single-response limits. No partial or stale catalogue is returned. Use the versioned manifest or the complete verified download.',manifest:manifest.manifestPath,complete_download:manifest.downloadPath,raw_limit_bytes:32*1024*1024,gzip_limit_bytes:8*1024*1024});
+  return async function handle(request, env) {
+    if (new URL(request.url).pathname !== '/data/papers.json') return env.ASSETS.fetch(request);
+    if (!['GET','HEAD'].includes(request.method)) return new Response('Method not allowed',{status:405,headers:{Allow:'GET, HEAD','Cache-Control':'no-store'}});
+    return new Response(request.method==='HEAD'?null:body,{status:409,headers:{'Content-Type':'application/problem+json; charset=utf-8','Cache-Control':'no-store','X-Content-Type-Options':'nosniff','Link':'</data/papers-v1/manifest.json>; rel="alternate"; type="application/json", </data/papers-v1/download.html>; rel="alternate"; type="text/html"'}});
+  };
+}
